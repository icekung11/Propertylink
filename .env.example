# Use a dedicated application database role in production.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/propertylink_db?schema=public
# Supply a private random secret of at least 32 bytes.
AUTH_SECRET=
APP_URL=http://localhost:3000
# Must be a persistent volume in production; the default is ./.uploads.
UPLOAD_DIRECTORY=./.uploads
# Optional development setting; required for production password reset delivery.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=

# Optional local PostgreSQL container (compose.yaml). Set a private password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional: enable password login on new/disabled demo seed accounts.
# SEED_PASSWORD=
