generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  settings                                 UserSettings?
  id                                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                    String                   @unique(map: "uq_users_email") @db.VarChar(254)
  password_hash                            String                   @db.VarChar(255)
  firstName                                String                   @map("first_name") @db.VarChar(100)
  lastName                                 String                   @map("last_name") @db.VarChar(100)
  phone                                    String                   @unique(map: "uq_users_phone") @db.VarChar(20)
  status                                   String                   @default("pending_verification") @db.VarChar(30)
  email_verified_at                        DateTime?                @db.Timestamptz(6)
  phone_verified_at                        DateTime?                @db.Timestamptz(6)
  kyc_status                               String                   @default("unverified") @db.VarChar(20)
  last_login_at                            DateTime?                @db.Timestamptz(6)
  token_version                            Int                      @default(1)
  pdpa_accepted_at                         DateTime?                @db.Timestamptz(6)
  createdAt                                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  deleted_at                               DateTime?                @db.Timestamptz(6)
  audit_logs                               audit_logs[]
  contact_history                          contact_history[]
  favorites                                Favorite[]
  buyerInquiries                           Inquiry[]                @relation("BuyerInquiries")
  inquiries_inquiries_seller_idTousers     Inquiry[]                @relation("inquiries_seller_idTousers")
  inquiry_messages                         inquiry_messages[]
  listing_status_history                   listing_status_history[]
  listings                                 Listing[]
  moderation_actions                       moderation_actions[]
  notifications                            Notification[]
  otp_verifications                        otp_verifications[]
  phone_reveals                            phone_reveals[]
  user_consents                            user_consents[]
  user_roles_user_roles_assigned_byTousers UserRole[]               @relation("user_roles_assigned_byTousers")
  userRoles                                UserRole[]

  @@index([kyc_status], map: "idx_users_kyc")
  @@map("users")
}

model Category {
  id         BigInt    @id @default(autoincrement())
  parent_id  BigInt?
  code       String    @unique(map: "uq_categories_code") @db.VarChar(50)
  name       String    @db.VarChar(200)
  slug       String    @unique(map: "uq_categories_slug") @db.VarChar(200)
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  listings   Listing[]

  @@index([parent_id], map: "idx_categories_parent")
  @@map("categories")
}

model Listing {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingNo              String                   @unique(map: "uq_listings_no") @map("listing_no") @db.VarChar(50)
  sellerId               String                   @map("seller_id") @db.Uuid
  categoryId             BigInt                   @map("category_id")
  location_id            BigInt
  title                  String                   @db.VarChar(255)
  slug                   String                   @unique(map: "uq_listings_slug") @db.VarChar(255)
  description            String?
  contactPhone           String?                  @map("contact_phone") @db.VarChar(30)
  contactEmail           String?                  @map("contact_email") @db.VarChar(254)
  contactLine            String?                  @map("contact_line") @db.VarChar(100)
  price                  Decimal?                 @db.Decimal(15, 2)
  landAreaSqwa           Decimal?                 @map("land_area_sqwa") @db.Decimal(10, 2)
  usableAreaSqm          Decimal?                 @map("usable_area_sqm") @db.Decimal(10, 2)
  bedrooms               Int?                     @db.SmallInt
  bathrooms              Int?                     @db.SmallInt
  status                 String                   @default("DRAFT") @db.VarChar(30)
  rejection_reason       String?
  submitted_at           DateTime?                @db.Timestamptz(6)
  approved_at            DateTime?                @db.Timestamptz(6)
  rejected_at            DateTime?                @db.Timestamptz(6)
  revision_at            DateTime?                @db.Timestamptz(6)
  publishedAt            DateTime?                @map("published_at") @db.Timestamptz(6)
  sold_at                DateTime?                @db.Timestamptz(6)
  closed_at              DateTime?                @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  contact_history        contact_history[]
  favoritedBy            Favorite[]
  inquiries              Inquiry[]
  images                 ListingImage[]
  listing_status_history listing_status_history[]
  category               Category                 @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "fk_listings_category")
  locations              Location                 @relation(fields: [location_id], references: [id], onUpdate: NoAction, map: "fk_listings_location")
  seller                 User                     @relation(fields: [sellerId], references: [id], onUpdate: NoAction, map: "fk_listings_seller")
  moderation_actions     moderation_actions[]
  phone_reveals          phone_reveals[]

  @@index([categoryId], map: "idx_listings_category")
  @@index([location_id], map: "idx_listings_location")
  @@index([price], map: "idx_listings_price")
  @@index([sellerId], map: "idx_listings_seller")
  @@index([status], map: "idx_listings_status")
  @@map("listings")
}

model Inquiry {
  id                               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId                        String             @map("listing_id") @db.Uuid
  buyerId                          String             @map("buyer_id") @db.Uuid
  sellerId                         String             @map("seller_id") @db.Uuid
  subject                          String?            @db.VarChar(255)
  message                          String
  status                           String             @default("PENDING") @db.VarChar(20)
  read_at                          DateTime?          @db.Timestamptz(6)
  replied_at                       DateTime?          @db.Timestamptz(6)
  closed_at                        DateTime?          @db.Timestamptz(6)
  createdAt                        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  buyer                            User               @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inquiries_buyer")
  listings                         Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inquiries_listing")
  users_inquiries_seller_idTousers User               @relation("inquiries_seller_idTousers", fields: [sellerId], references: [id], onUpdate: NoAction, map: "fk_inquiries_seller")
  inquiry_messages                 inquiry_messages[]

  @@index([buyerId], map: "idx_inquiries_buyer")
  @@index([listingId], map: "idx_inquiries_listing")
  @@index([sellerId], map: "idx_inquiries_seller")
  @@index([status], map: "idx_inquiries_status")
  @@map("inquiries")
}

model ListingImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  storage_key String   @db.VarChar(500)
  image_url   String   @db.VarChar(500)
  phash_code  String?  @db.VarChar(16)
  isCover     Boolean  @default(false) @map("is_cover")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listing_images_listing")

  @@index([listingId], map: "idx_listing_images_listing")
  @@map("listing_images")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_favorites_listing")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_favorites_user")

  @@id([userId, listingId], map: "pk_favorites")
  @@index([listingId], map: "idx_favorites_listing")
  @@map("favorites")
}

model Location {
  id            BigInt    @id @default(autoincrement())
  parentId      BigInt?   @map("parent_id")
  location_type String    @db.VarChar(50)
  name          String    @db.VarChar(200)
  postal_code   String?   @db.VarChar(5)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  listings      Listing[]

  @@index([postal_code], map: "idx_locations_postal")
  @@map("locations")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  body      String?
  payload   Json?
  isRead    Boolean   @default(false) @map("is_read")
  read_at   DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notifications_user")
  @@map("notifications")
}

model Role {
  id               Int                @id @default(autoincrement())
  code             String             @unique(map: "uq_roles_code") @db.VarChar(50)
  name             String             @db.VarChar(100)
  description      String?
  is_system        Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  userRoles        UserRole[]

  @@map("roles")
}

model UserRole {
  // Database-only uq_user_single_role enforces one role per user. The relation
  // remains a list in Prisma for compatibility with existing query consumers.
  // Preserve that unique index when reviewing future generated migrations.
  userId                              String   @map("user_id") @db.Uuid
  roleId                              Int      @map("role_id")
  assignedAt                          DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assigned_by                         String?  @db.Uuid
  users_user_roles_assigned_byTousers User?    @relation("user_roles_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction, map: "fk_user_roles_assigned_by")
  role                                Role     @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "fk_user_roles_role")
  user                                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@id([userId, roleId], map: "pk_user_roles")
  @@index([roleId], map: "idx_user_roles_role")
  @@map("user_roles")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id               BigInt   @id @default(autoincrement())
  actor_user_id    String?  @db.Uuid
  actor_user_email String?  @db.VarChar(254)
  action           String   @db.VarChar(100)
  entity_type      String   @db.VarChar(50)
  entity_id        String?  @db.VarChar(100)
  ip_address       String?  @db.VarChar(45)
  user_agent       String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  users            User?    @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction, map: "fk_audit_logs_user")

  @@index([actor_user_id], map: "idx_audit_logs_actor")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contact_history {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  listing_id   String   @db.Uuid
  contact_type String   @db.VarChar(30)
  contact_at   DateTime @default(now()) @db.Timestamptz(6)
  listings     Listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_history_listing")
  users        User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contact_history_user")

  @@index([user_id, contact_at(sort: Desc)], map: "idx_contact_history_user")
}

model inquiry_messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiry_id String   @db.Uuid
  sender_id  String   @db.Uuid
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  inquiries  Inquiry  @relation(fields: [inquiry_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inquiry_messages_inquiry")
  users      User     @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inquiry_messages_sender")

  @@index([inquiry_id, created_at(sort: Desc)], map: "idx_inquiry_messages_inquiry")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model listing_status_history {
  id          BigInt   @id @default(autoincrement())
  listing_id  String   @db.Uuid
  from_status String?  @db.VarChar(30)
  to_status   String   @db.VarChar(30)
  changed_by  String?  @db.Uuid
  reason      String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  listings    Listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listing_status_history_listing")
  users       User?    @relation(fields: [changed_by], references: [id], onUpdate: NoAction, map: "fk_listing_status_history_user")

  @@index([listing_id, created_at(sort: Desc)], map: "idx_listing_status_history_listing")
  @@index([changed_by], map: "idx_listing_status_history_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model moderation_actions {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id        String   @db.Uuid
  admin_id          String?  @db.Uuid
  action            String   @db.VarChar(50)
  reason_code       String?  @db.VarChar(50)
  moderator_comment String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  users             User?    @relation(fields: [admin_id], references: [id], onUpdate: NoAction, map: "fk_moderation_actions_admin")
  listings          Listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_moderation_actions_listing")

  @@index([admin_id], map: "idx_moderation_actions_admin")
  @@index([listing_id], map: "idx_moderation_actions_listing")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model otp_verifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  phone      String    @db.VarChar(20)
  otp_code   String    @db.VarChar(64)
  purpose    String    @db.VarChar(30)
  attempts   Int       @default(0)
  is_used    Boolean   @default(false)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_otp_verifications_user")

  @@index([expires_at], map: "idx_otp_expires")
}

model permissions {
  id               Int                @id @default(autoincrement())
  code             String             @unique(map: "uq_permissions_code") @db.VarChar(100)
  module           String             @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

model phone_reveals {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id    String   @db.Uuid
  listing_id  String   @db.Uuid
  revealed_at DateTime @default(now()) @db.Timestamptz(6)
  users       User     @relation(fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_phone_reveals_buyer")
  listings    Listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_phone_reveals_listing")

  @@index([buyer_id], map: "idx_phone_reveals_buyer")
  @@index([listing_id], map: "idx_phone_reveals_listing")
}

model role_permissions {
  role_id       Int
  permission_id Int
  granted_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         Role        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id], map: "pk_role_permissions")
  @@index([permission_id], map: "idx_role_permissions_permission")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_consents {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  consent_type String    @db.VarChar(50)
  version      String    @db.VarChar(20)
  is_accepted  Boolean
  accepted_at  DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  ip_address   String?   @db.VarChar(45)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_consents_user")

  @@index([user_id], map: "idx_user_consents_user")
}

model UserSettings {
  userId String @id @map("user_id") @db.Uuid
  language String @default("en") @db.VarChar(2)
  currency String @default("THB") @db.VarChar(3)
  showUnreadBadge Boolean @default(true) @map("show_unread_badge")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_settings")
}
